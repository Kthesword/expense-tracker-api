{
	"info": {
		"_postman_id": "expense-tracker-api-collection",
		"name": "Expense Tracker API",
		"description": "Complete collection for Expense Tracker API with auto-token handling.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/health",
					"host": ["{{baseUrl}}"],
					"path": ["health"]
				}
			}
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "1. Signup",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Jafer Dev\",\n    \"email\": \"jafer@example.com\",\n    \"password\": \"strongpassword123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/signup",
							"host": ["{{baseUrl}}"],
							"path": ["signup"]
						}
					}
				},
				{
					"name": "2. Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"jafer@example.com\",\n    \"password\": \"strongpassword123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/login",
							"host": ["{{baseUrl}}"],
							"path": ["login"]
						}
					}
				}
			]
		},
		{
			"name": "Expenses",
			"item": [
				{
					"name": "Create Expense (Today)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Lunch with Team\",\n    \"description\": \"Pizza and drinks\",\n    \"amount\": 28.50,\n    \"category\": \"Food\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/expenses",
							"host": ["{{baseUrl}}"],
							"path": ["expenses"]
						}
					}
				},
				{
					"name": "Create Expense (Custom Date)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Wireless Headphones\",\n    \"description\": \"Sony noise cancelling\",\n    \"amount\": 150.00,\n    \"category\": \"Electronics\",\n    \"date\": \"2026-10-10\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/expenses",
							"host": ["{{baseUrl}}"],
							"path": ["expenses"]
						}
					}
				},
				{
					"name": "List All Expenses",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/expenses",
							"host": ["{{baseUrl}}"],
							"path": ["expenses"]
						}
					}
				},
				{
					"name": "Filter: Past Week",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/expenses?filter=week",
							"host": ["{{baseUrl}}"],
							"path": ["expenses"],
							"query": [
								{
									"key": "filter",
									"value": "week"
								}
							]
						}
					}
				},
				{
					"name": "Filter: Past Month",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/expenses?filter=month",
							"host": ["{{baseUrl}}"],
							"path": ["expenses"],
							"query": [
								{
									"key": "filter",
									"value": "month"
								}
							]
						}
					}
				},
				{
					"name": "Filter: Last 3 Months",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/expenses?filter=3months",
							"host": ["{{baseUrl}}"],
							"path": ["expenses"],
							"query": [
								{
									"key": "filter",
									"value": "3months"
								}
							]
						}
					}
				},
				{
					"name": "Filter: Custom Date Range",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/expenses?filter=custom&start=2026-10-01&end=2026-10-31",
							"host": ["{{baseUrl}}"],
							"path": ["expenses"],
							"query": [
								{
									"key": "filter",
									"value": "custom"
								},
								{
									"key": "start",
									"value": "2026-10-01"
								},
								{
									"key": "end",
									"value": "2026-10-31"
								}
							]
						}
					}
				},
				{
					"name": "Filter: By Category (Food)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/expenses?category=Food",
							"host": ["{{baseUrl}}"],
							"path": ["expenses"],
							"query": [
								{
									"key": "category",
									"value": "Food"
								}
							]
						}
					}
				},
				{
					"name": "Get Expense by ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/expenses/1",
							"host": ["{{baseUrl}}"],
							"path": ["expenses", "1"]
						}
					}
				},
				{
					"name": "Update Expense (PATCH)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"amount\": 35.00,\n    \"description\": \"Team lunch + dessert\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/expenses/1",
							"host": ["{{baseUrl}}"],
							"path": ["expenses", "1"]
						}
					}
				},
				{
					"name": "Delete Expense",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/expenses/1",
							"host": ["{{baseUrl}}"],
							"path": ["expenses", "1"]
						}
					}
				}
			]
		}
	]
}
